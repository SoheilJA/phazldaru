.pnp.*
package-lock.json    # keep if you prefer lockfiles in git; delete this line to track it

# ---------- Internal ----------
AGENT-PROGRESS.md

# ---------- OS / editor junk ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- Editors ----------
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ---------- Env & secrets ----------
.env
.env.*
!.env.example

# ---------- Caches ----------
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.log

# ---------- Deploy / platform dotfiles ----------
.netlify/
.vercel/
.firebase/
